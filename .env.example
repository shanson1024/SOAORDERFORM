# First admin account. Used once, when the database has no accounts yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-10-or-more-characters

# Where the database file lives. Point this at a persistent disk in production.
DATA_DIR=./data
PORT=3000

# Set to "production" behind HTTPS so the login cookie is marked Secure.
NODE_ENV=development

# Optional. Turns on email drafts and pipeline summaries.
# ANTHROPIC_API_KEY=
