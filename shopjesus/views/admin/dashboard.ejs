<%- include('../partials/head') %>
<div class="wrap">
  <h1 class="page-title">Dashboard</h1>
  <div class="stats">
    <a class="stat <%= stats.toShip ? 'stat-alert' : '' %>" href="/admin/orders?status=paid"><b><%= stats.toShip %></b><span>Orders to ship</span></a>
    <div class="stat"><b><%= money(stats.today.c) %></b><span>Today (<%= stats.today.n %> orders)</span></div>
    <div class="stat"><b><%= money(stats.month.c) %></b><span>Last 30 days (<%= stats.month.n %> orders)</span></div>
    <div class="stat"><b><%= money(stats.all.c) %></b><span>All time (<%= stats.all.n %> orders)</span></div>
  </div>
  <div class="section-head"><h2>Recent orders</h2><a href="/admin/orders">All orders</a></div>
  <%- include('orders-table', { orders: recent }) %>
  <div class="section-head"><h2>Low stock</h2><a href="/admin/products">All products</a></div>
  <% if (!lowStock.length) { %><p class="empty">Nothing is running low.</p><% } else { %>
  <div class="table-scroll"><table class="table">
    <thead><tr><th>Product</th><th>Option</th><th class="num">Stock</th></tr></thead>
    <tbody><% for (const v of lowStock) { %>
      <tr><td><a href="/admin/products/<%= v.id %>"><%= v.name %></a></td><td><%= v.color %> / <%= v.size %></td><td class="num"><%= v.stock %></td></tr>
    <% } %></tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
