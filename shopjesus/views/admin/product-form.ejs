<%- include('../partials/head') %>
<div class="wrap narrow">
  <p class="crumbs"><a href="/admin/products">Products</a> / <%= product.id ? product.name : 'New' %></p>
  <h1 class="page-title"><%= product.id ? 'Edit product' : 'New product' %></h1>
  <form method="post" enctype="multipart/form-data" class="form"
    action="/admin/products/<%= product.id || 'new' %>?_csrf=<%= encodeURIComponent(csrf) %>">
    <label>Name<input name="name" value="<%= product.name || '' %>" required maxlength="120"></label>
    <div class="row2">
      <label>Category
        <select name="category"><% for (const [key, label] of Object.entries(CATEGORIES)) { %>
          <option value="<%= key %>" <%= product.category === key ? 'selected' : '' %>><%= label %></option><% } %>
        </select>
      </label>
      <label>Price (USD)<input name="price" type="number" step="0.01" min="0" value="<%= product.price_cents != null ? (product.price_cents / 100).toFixed(2) : '' %>" required></label>
    </div>
    <label>Description<textarea name="description" rows="4"><%= product.description || '' %></textarea></label>
    <% if (colors.length) { %>
    <h3>Photos by color</h3>
    <p class="hint">JPG, PNG or WebP, up to 6 MB each. Shoppers see the photo for the color they pick.</p>
    <% colors.forEach((c, i) => { %>
    <div class="color-photo">
      <% if (c.url) { %><img class="thumb" src="<%= c.url %>" alt=""><% } else { %><span class="thumb"></span><% } %>
      <label><span class="dots"><i style="background:<%= c.color_hex %>"></i></span> <%= c.color %>
        <input type="hidden" name="cimg_color[<%= i %>]" value="<%= c.color %>">
        <input type="file" name="cimg_<%= i %>" accept="image/jpeg,image/png,image/webp"></label>
      <% if (c.url) { %><label class="check"><input type="checkbox" name="cimg_remove[<%= i %>]" value="1"> Remove</label><% } %>
    </div>
    <% }) %>
    <% } else { %><p class="hint">Save the product with its colors first, then add a photo for each color.</p><% } %>
    <label>General photo (used for any color without its own)<input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label>
    <% if (product.image) { %>
      <p><img class="thumb-lg" src="<%= product.image.startsWith('/') ? product.image : '/uploads/' + product.image %>" alt=""></p>
      <label class="check"><input type="checkbox" name="remove_image" value="1"> Remove general photo</label>
    <% } %>
    <label>Mock-up text (only shown if there is no photo)<input name="design_text" value="<%= product.design_text || '' %>" maxlength="40"></label>
    <label class="check"><input type="checkbox" name="active" value="1" <%= product.active ? 'checked' : '' %>> Visible in the store</label>
    <label class="check"><input type="checkbox" name="featured" value="1" <%= product.featured ? 'checked' : '' %>> Featured on the home page</label>

    <% if (variants.length) { %>
    <h3><%= config.madeToOrder ? 'Colors and sizes' : 'Inventory' %></h3>
    <div class="table-scroll"><table class="table">
      <thead><tr><th>Color</th><th>Size</th><% if (!config.madeToOrder) { %><th>In stock</th><% } %><th>Delete</th></tr></thead>
      <tbody><% for (const v of variants) { %>
        <tr>
          <td><span class="dots"><i style="background:<%= v.color_hex %>"></i></span> <%= v.color %></td>
          <td><%= v.size %></td>
          <% if (!config.madeToOrder) { %><td><input class="stock-input" type="number" min="0" name="stock[<%= v.id %>]" value="<%= v.stock %>"></td><% } %>
          <td><% if (config.madeToOrder) { %><input type="hidden" name="stock[<%= v.id %>]" value="<%= v.stock %>"><% } %><input type="checkbox" name="delete[<%= v.id %>]" value="1"></td>
        </tr>
      <% } %></tbody>
    </table></div>
    <% } %>

    <h3>Add colors and sizes</h3>
    <p class="hint">One color per line, with an optional hex code. Every color is created in every size listed.</p>
    <label>Colors<textarea name="new_colors" rows="3" placeholder="Black #151515&#10;White #f4f4f2"></textarea></label>
    <div class="row2">
      <label>Sizes (comma separated)<input name="new_sizes" placeholder="S, M, L, XL, 2XL"></label>
      <% if (!config.madeToOrder) { %><label>Starting stock for each<input name="new_stock" type="number" min="0" value="0"></label><% } %>
    </div>
    <button class="btn btn-red btn-block">Save product</button>
  </form>
</div>
<%- include('../partials/foot') %>
