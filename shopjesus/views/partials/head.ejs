<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' | ' + config.storeName : config.storeName + ' | Faith Apparel: Tees, Hoodies & Hats' %></title>
<meta name="description" content="Christian t-shirts, hoodies and hats from ShopJesus.com. Wear your faith out loud.">
<link rel="icon" href="/img/favicon.png">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="promo">Free shipping on orders over <%= money(config.freeShippingThresholdCents) %></div>
<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/"><img src="/img/logo.png" alt="ShopJesus.com" width="640" height="270"></a>
    <nav class="main-nav" aria-label="Main">
      <a href="/shop">Shop All</a>
      <% for (const [key, label] of Object.entries(CATEGORIES)) { %><a href="/shop?category=<%= key %>"><%= label %></a><% } %>
    </nav>
    <a class="cart-link" href="/cart" aria-label="Cart">Cart <span class="cart-count"><%= cartCount %></span></a>
  </div>
</header>
<% if (isAdmin) { %>
<div class="admin-bar"><div class="wrap">
  <a href="/admin">Dashboard</a><a href="/admin/orders">Orders</a><a href="/admin/products">Products</a>
  <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike">Log out</button></form>
</div></div>
<% } %>
<main>
<% if (flash) { %><div class="wrap"><div class="flash flash-<%= flash.type %>"><%= flash.text %></div></div><% } %>
