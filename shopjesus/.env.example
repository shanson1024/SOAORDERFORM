# Copy to .env for local use. On Railway, set these as service variables.

# Required in production
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password
BASE_URL=https://shopjesus.com

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to true after enabling Stripe Tax in your Stripe dashboard
STRIPE_TAX=false

# Where the database and uploaded photos live. Point this at a persistent volume.
DATA_DIR=/data

# Store settings
CONTACT_EMAIL=support@shopjesus.com
SHIPPING_FLAT_CENTS=595
FREE_SHIPPING_THRESHOLD_CENTS=9900
SHIP_COUNTRIES=US
# Items are made to order, so stock is not tracked. Set to false to track inventory.
MADE_TO_ORDER=true

# Optional: order emails (confirmation + shipped). Any SMTP provider works.
SMTP_URL=
MAIL_FROM=ShopJesus.com <orders@shopjesus.com>
ORDER_NOTIFY_EMAIL=
